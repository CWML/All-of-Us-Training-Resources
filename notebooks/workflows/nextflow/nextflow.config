// General All of Us settings only. Your workspace's project and account are NOT here
// (never commit them): the Workflows tab supplies them. To run in an app, add
// google.project and google.batch.serviceAccountEmail (see the test notebook).

process.executor  = "google-batch"
process.container = "us-central1-docker.pkg.dev/all-of-us-rw-prod/aou-rw-gar-remote-repo-docker-prod/biocontainer/plink2:alpha2.3_jan2020"   // must include ps

google.location = "us-central1"
google.enableRequesterPaysBuckets = true
google.batch.network           = "global/networks/network"
google.batch.subnetwork        = "regions/us-central1/subnetworks/subnetwork"
google.batch.usePrivateAddress = true
google.batch.copyImage         = "gcr.io/google.com/cloudsdktool/google-cloud-cli:591.0.0-alpine"   // pinned
